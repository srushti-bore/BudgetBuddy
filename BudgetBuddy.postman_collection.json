							"raw": "{{baseUrl}}/api/v1/expenses/{{createdExpenseId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "expenses", "{{createdExpenseId}}"]
						},
						"description": "Updates the row in PostgreSQL."
					},
					"response": []
				},
				{
					"name": "DB Test: Filter & Search Query (GET)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var data = pm.response.json();",
									"pm.test(\"Returns paginated data structure\", function () {",
									"    pm.expect(data.content).to.be.an('array');",
									"    pm.expect(data.totalElements).to.be.greaterThan(0);",
									"    pm.expect(data.page).to.eql(0);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/expenses?category=SHOPPING&page=0&size=10&sortBy=expenseDate&direction=desc",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "expenses"],
							"query": [
								{ "key": "category", "value": "SHOPPING" },
								{ "key": "page", "value": "0" },
								{ "key": "size", "value": "10" },
								{ "key": "sortBy", "value": "expenseDate" },
								{ "key": "direction", "value": "desc" }
							]
						},
						"description": "Validates dynamic JPA Specification filtering on DB."
