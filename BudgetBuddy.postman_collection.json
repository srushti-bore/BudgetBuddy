		{
			"name": "3. Expense & Database Persistence Tests",
			"item": [
				{
					"name": "DB Test: Create New Expense (POST)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Expense created with HTTP 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"var data = pm.response.json();",
									"pm.test(\"Expense has auto-generated DB ID and correct fields\", function () {",
									"    pm.expect(data.id).to.be.a('number');",
									"    pm.expect(data.title).to.eql(\"Postman Automated Test Purchase\");",
									"    pm.expect(data.amount).to.eql(1499.00);",
									"    pm.expect(data.category).to.eql(\"SHOPPING\");",
									"});",
									"pm.collectionVariables.set(\"createdExpenseId\", data.id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Postman Automated Test Purchase\",\n  \"amount\": 1499.00,\n  \"category\": \"SHOPPING\",\n  \"expenseDate\": \"2026-08-22\",\n  \"description\": \"Created via Postman test script for DB verification\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/expenses",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "expenses"]
						},
						"description": "Inserts a new expense row into PostgreSQL database."
					},
					"response": []
				},
				{
					"name": "DB Test: Read Expense by ID (GET)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var data = pm.response.json();",
									"pm.test(\"Data matches what was stored in PostgreSQL\", function () {",
									"    pm.expect(data.id.toString()).to.eql(pm.collectionVariables.get(\"createdExpenseId\").toString());",
									"    pm.expect(data.title).to.eql(\"Postman Automated Test Purchase\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
